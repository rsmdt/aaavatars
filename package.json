{
  "name": "aaavatars",
  "version": "5.0.0",
  "description": "Deterministic 2D character avatars with a play() animation API",
  "keywords": [
    "avatar",
    "react",
    "svg",
    "ai-agent",
    "agent-avatar",
    "animation",
    "identicon",
    "generative",
    "deterministic"
  ],
  "author": "Rudolf Schmidt",
  "license": "MIT",
  "homepage": "https://rsmdt.github.io/aaavatars/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsmdt/aaavatars.git"
  },
  "bugs": {
    "url": "https://github.com/rsmdt/aaavatars/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "vite build --base=/aaavatars/ --outDir demo-dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
